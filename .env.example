# ─────────────────────────────────────────────────────────────
#  Oil Center — environment variables
#  Copy to .env.local for development, set real values in production.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (no trailing slash). Used in emails, sitemap, payment return URLs. In production it also
# makes src/proxy.ts redirect every other host (bare oilcenter.gr, the *.up.railway.app address) to this origin.
SITE_URL=http://localhost:3000

# Only if you put a reverse proxy that APPENDS to X-Forwarded-For (nginx, Caddy) in front of the app:
# set this to the number of such proxies so the rate limiter reads the real client IP and a spoofed header
# cannot dodge it. Leave empty (0) on hosts whose edge overwrites X-Forwarded-For, e.g. Railway. See src/lib/rate-limit.ts.
TRUSTED_PROXY_HOPS=

# Database. Local SQLite file by default.
# For serverless hosting (e.g. Vercel) use a Turso database instead:
#   DATABASE_URL=libsql://<db-name>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token>
DATABASE_URL=file:./data/shop.db
DATABASE_AUTH_TOKEN=

# Where admin uploads, the dev e-mail outbox and DB backups are stored.
# Must be a persistent disk in production.
DATA_DIR=./data

# ── Off-site backups to Backblaze B2 (all four or none). See src/lib/backup-offsite.ts and README.
# App key restricted to ONE bucket; create it in the B2 dashboard ("Application Keys" → allow access to bucket only).
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
# Encrypts every uploaded backup (AES-256-GCM) BEFORE it leaves the server. The B2 account cannot decrypt it.
# Generate with: openssl rand -base64 32
# Keep TWO offline copies (owner + developer, password managers). This variable is the app's working copy;
# the offline copies are what makes a restore possible after the Railway account itself is lost.
BACKUP_ENCRYPTION_KEY=

# Secret used to sign login cookies. Generate with:  openssl rand -base64 48
AUTH_SECRET=

# First admin account, created by `npm run db:seed` (or `npm run admin:create`).
ADMIN_EMAIL=admin@oilcenter.gr
ADMIN_PASSWORD=

# Pre-launch curtain: while SITE_PASSWORD is set, the whole site asks for this user name and password
# (browser login box) before showing anything. Remove the variable on launch day. See src/proxy.ts.
SITE_USER=oilcenter
SITE_PASSWORD=

# Deployment-level commerce switch. Set to false for the catalogue-only website: no orders, no customer
# accounts, no payments — enforced server-side regardless of Admin → Ρυθμίσεις or who is logged in.
# Remove the variable (or set true) on the day the e-shop opens. See src/lib/commerce-flag.ts.
COMMERCE_ENABLED=false

# ── E-mail. With neither RESEND_API_KEY nor SMTP_HOST, e-mails are written to DATA_DIR/outbox instead of being sent.
# Resend (HTTPS API) — use it where the host blocks outgoing SMTP. Wins over SMTP when set.
RESEND_API_KEY=
# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender. Leave empty to send as the SMTP login itself (right for Gmail, which rewrites any other From address),
# or as Resend's shared test address (delivers only to the Resend account's own mailbox).
# An @oilcenter.gr sender needs a sending service plus its SPF/DKIM records at the DNS host — see DOMAIN.md.
MAIL_FROM=
# Where "new order" and contact-form notifications go. Leave empty to use the shop e-mail from Admin → Ρυθμίσεις.
ORDERS_NOTIFY_EMAIL=

# ── Card payments. Leave a provider's keys empty to disable it. If both are set, Viva is used.
# Viva (viva.com) Smart Checkout — https://developer.viva.com/smart-checkout/
VIVA_ENV=demo
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_SOURCE_CODE=
# Merchant ID + API key are only needed to answer Viva's webhook verification request.
VIVA_MERCHANT_ID=
VIVA_API_KEY=
# Optional: comma-separated addresses Viva calls the webhook from: IPv4, IPv4 ranges like 40.127.253.112/28, or IPv6 (copy Viva's
# current list). Empty = no allow-list. The server refuses to boot on an entry it cannot read.
# VIVA_ENV must be exactly demo or live once the Viva keys are set.
# VIVA_WEBHOOK_IPS=
# (VIVA_TEST_BASE_URL exists only for scripts/test-card-flow.ts. Never set it on a server: it is ignored when VIVA_ENV=live
# and the startup check refuses to boot with both.)

# Stripe Checkout — https://docs.stripe.com/payments/checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
