# ─────────────────────────────────────────────────────────────
#  Oil Center — environment variables
#  Copy to .env.local for development, set real values in production.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (no trailing slash). Used in emails, sitemap, payment return URLs.
SITE_URL=http://localhost:3000

# Only if you put a reverse proxy that APPENDS to X-Forwarded-For (nginx, Caddy) in front of the app:
# set this to the number of such proxies so the rate limiter reads the real client IP and a spoofed header
# cannot dodge it. Leave empty (0) on hosts whose edge overwrites X-Forwarded-For, e.g. Railway. See src/lib/rate-limit.ts.
TRUSTED_PROXY_HOPS=

# Database. Local SQLite file by default.
# For serverless hosting (e.g. Vercel) use a Turso database instead:
#   DATABASE_URL=libsql://<db-name>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token>
DATABASE_URL=file:./data/shop.db
DATABASE_AUTH_TOKEN=

# Where admin uploads, the dev e-mail outbox and DB backups are stored.
# Must be a persistent disk in production.
DATA_DIR=./data

# Secret used to sign login cookies. Generate with:  openssl rand -base64 48
AUTH_SECRET=

# First admin account, created by `npm run db:seed` (or `npm run admin:create`).
ADMIN_EMAIL=admin@oilcenter.gr
ADMIN_PASSWORD=

# Pre-launch curtain: while SITE_PASSWORD is set, the whole site asks for this user name and password
# (browser login box) before showing anything. Remove the variable on launch day. See src/proxy.ts.
SITE_USER=oilcenter
SITE_PASSWORD=

# ── E-mail (SMTP). If SMTP_HOST is empty, e-mails are written to DATA_DIR/outbox instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Oil Center <orders@oilcenter.gr>"
# Where "new order" and contact-form notifications go (the shop's inbox).
ORDERS_NOTIFY_EMAIL=iliastsakiridis@hotmail.com

# ── Card payments. Leave a provider's keys empty to disable it. If both are set, Viva is used.
# Viva (viva.com) Smart Checkout — https://developer.viva.com/smart-checkout/
VIVA_ENV=demo
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_SOURCE_CODE=
# Merchant ID + API key are only needed to answer Viva's webhook verification request.
VIVA_MERCHANT_ID=
VIVA_API_KEY=

# Stripe Checkout — https://docs.stripe.com/payments/checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
